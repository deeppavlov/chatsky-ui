{
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "arrowParens": "always",
  "trailingComma": "all",
  "printWidth": 80,
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "quoteProps": "as-needed",
  "endOfLine": "lf",
  "importOrder": [
    "^/(.*)$",
    "^assets/(.*)$",
    "^router/(.*)$",
    "^types/(.*)$",
    "^context/(.*)$",
    "^constants/(.*)$",
    "^mapping/(.*)$",
    "^api/(.*)$",
    "^hooks/(.*)$",
    "^utils/(.*)$",
    "^ui/(.*)$",
    "^components/(.*)$",
    "^[./]"
  ],
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ]
}
